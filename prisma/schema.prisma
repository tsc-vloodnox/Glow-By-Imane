generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  NOUVELLE
  DISCUSSION_WHATSAPP
  CONFIRMEE
  PREPARATION
  EN_LIVRAISON
  LIVREE
  ANNULEE
}

/// DETAIL : commande boutique classique (stock réservé à la création).
/// GROS : demande revendeur — prix négociés, stock réservé seulement à la confirmation
/// (et pouvant devenir négatif = à réapprovisionner).
enum OrderKind {
  DETAIL
  GROS
}

/// LIVRAISON : livrée chez le client. RETRAIT : la cliente vient chercher sa commande au point relais.
enum DeliveryMode {
  LIVRAISON
  RETRAIT
}

/// Coût d'une tournée : calculé (départ + km + arrêts) ou forfait saisi à la main.
enum RunCostMode {
  CALCULE
  FORFAIT
}

enum RunStatus {
  PLANIFIEE
  EN_COURS
  TERMINEE
}

enum DeliveryStatus {
  PLANIFIEE
  EN_COURS
  LIVREE
  ECHOUEE
  REPORTEE
}

enum GiftCardStatus {
  DRAFT
  PUBLISHED
}

model Category {
  id       String    @id @default(cuid())
  name     String
  products Product[]
}

model Product {
  id            String      @id @default(cuid())
  name          String
  /// Identifiant lisible dans l'URL (/produits/<slug>), généré à la création, stable ensuite.
  /// Le défaut côté base ne sert qu'à l'ancienne version du code (migration rétrocompatible) :
  /// createProduct fournit toujours un vrai slug (lib/slug.ts).
  slug          String      @unique @default(dbgenerated("('produit-'::text || substr(md5(((random())::text || (clock_timestamp())::text)), 1, 10))"))
  description   String
  price         Int
  originalPrice Int?
  stock         Int         @default(0)
  favorite      Boolean     @default(false)
  archived      Boolean     @default(false)
  images        String[]
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  sizes      ProductSize[]
  packPrices ProductPackPrice[]
  promotions ProductPromotion[]
  kitItems   KitItem[]

  @@index([categoryId])
  @@index([archived, createdAt])
}

/// Déclinaisons de contenance / taille (30ml, 50ml, 100ml...).
/// Chaque taille a son propre prix et son propre stock.
model ProductSize {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  label     String // ex: "30ml", "50ml"
  price     Int
  stock     Int     @default(0)
  position  Int     @default(0)
  archived  Boolean @default(false)

  packPrices ProductPackPrice[]
  orderItems OrderItem[]
  kitItems   KitItem[]

  @@unique([productId, label])
}

/// Paliers de prix par quantité (1 à X GNF, 3 à Y GNF...).
/// Rattaché soit directement au produit (pas de taille), soit à une taille précise.
model ProductPackPrice {
  id            String       @id @default(cuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  productSizeId String?
  productSize   ProductSize? @relation(fields: [productSizeId], references: [id])
  quantity      Int // 1, 3, 5...
  price         Int // prix total pour cette quantité
  position      Int          @default(0)

  @@unique([productId, productSizeId, quantity])
}

model Promotion {
  id              String             @id @default(cuid())
  name            String // ex: "Soldes été 2026"
  discountPercent Int // ex: 20 (pour -20%)
  startAt         DateTime
  endAt           DateTime
  active          Boolean            @default(true) // peut être désactivée manuellement
  products        ProductPromotion[]
  createdAt       DateTime           @default(now())
}

// Table de jointure — une promo peut couvrir plusieurs produits,
// un produit peut avoir plusieurs promos (on applique la plus avantageuse)
model ProductPromotion {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@index([productId])
}

/// Kit / bundle de produits (ex: "kit soin visage complet").
model Kit {
  id            String      @id @default(cuid())
  name          String
  description   String?
  price         Int // prix fixe du kit
  originalPrice Int?
  images        String[]
  archived      Boolean     @default(false)
  items         KitItem[]
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
}

model KitItem {
  id            String       @id @default(cuid())
  kitId         String
  kit           Kit          @relation(fields: [kitId], references: [id])
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  productSizeId String?
  productSize   ProductSize? @relation(fields: [productSizeId], references: [id])
  quantity      Int          @default(1)

  @@unique([kitId, productId, productSizeId])
  @@index([productId])
}

/// Fiche cliente, créée/mise à jour automatiquement à chaque commande.
/// `phone` est normalisé au format international sans "+" (224XXXXXXXXX) : un même
/// numéro saisi "620 00 00 00" ou "+224620000000" désigne la même cliente.
model Customer {
  id           String   @id @default(cuid())
  phone        String   @unique
  name         String
  quartier     String
  businessName String? // nom de la boutique (revendeurs)
  isReseller   Boolean  @default(false)
  notes        String? // notes internes de l'admin
  loyaltyPts   Int      @default(0) // règles de fidélité pas encore définies
  vip          Boolean  @default(false)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model Order {
  id     String      @id @default(cuid())
  number Int         @unique @default(autoincrement())
  status OrderStatus @default(NOUVELLE)
  kind   OrderKind   @default(DETAIL)
  source String      @default("app")

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  name     String
  phone    String
  quartier String
  comment  String?

  /// Nom de la boutique (commandes en gros)
  businessName String?

  /// Livraison ou retrait au point relais
  deliveryMode   DeliveryMode @default(LIVRAISON)
  quartierId     String?
  quartierRef    Quartier?    @relation(fields: [quartierId], references: [id])
  pickupPointId  String?
  pickupPoint    PickupPoint? @relation(fields: [pickupPointId], references: [id])
  /// Fourchette de frais annoncée à la cliente au moment de la commande (figée)
  deliveryFeeMin Int?
  deliveryFeeMax Int?
  /// Position partagée volontairement par la cliente (facultatif)
  locationLat    Float?
  locationLng    Float?

  estimatedTotal Int

  discountAmount Int     @default(0)
  discountReason String?

  finalTotal Int @default(0)

  /// Acompte encaissé hors application (espèces, mobile money…) : simple suivi interne
  depositAmount Int       @default(0)
  depositPaidAt DateTime?
  depositNote   String?

  /// true tant que le stock des articles est réservé (décrémenté) par cette commande.
  /// Passe à false quand le stock est restitué (annulation / suppression) → jamais restitué deux fois.
  /// Commandes boutique et commandes admin créées après la migration 20260928120000 : true à la création.
  stockReserved Boolean @default(false)

  items    OrderItem[]
  delivery Delivery?
  giftCard GiftCard?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([kind, createdAt])
  @@index([createdAt])
  @@index([phone, createdAt]) // anti-spam : commandes récentes par téléphone
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  productSizeId String?
  productSize   ProductSize? @relation(fields: [productSizeId], references: [id])

  kitId String?
  kit   Kit?    @relation(fields: [kitId], references: [id])

  quantity  Int
  unitPrice Int

  /// Commandes en gros : prix unitaire proposé par le revendeur dans sa demande (facultatif)
  requestedUnitPrice Int?

  /// Kit : contenu exact au moment de la commande (le kit peut être modifié ensuite)
  components OrderItemComponent[]

  @@index([orderId])
  @@index([productId])
  @@index([productSizeId])
  @@index([kitId])
}

/// Composant d'un kit commandé, figé au moment de la commande (quantité par unité de kit).
/// Volontairement sans clé étrangère vers Product/ProductSize : c'est une copie historique,
/// qui ne doit pas empêcher de supprimer plus tard une taille ou un produit.
model OrderItemComponent {
  id            String    @id @default(cuid())
  orderItemId   String
  orderItem     OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productId     String
  productSizeId String?
  quantity      Int

  @@index([orderItemId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

/// Livreurs enregistrés, pour grouper les livraisons par personne.
model Livreur {
  id     String  @id @default(cuid())
  name   String
  phone  String  @unique
  active Boolean @default(true)
  notes  String?

  deliveries Delivery[]
  runs       DeliveryRun[]
  createdAt  DateTime      @default(now())
}

model Delivery {
  id          String         @id @default(cuid())
  orderId     String         @unique
  order       Order          @relation(fields: [orderId], references: [id])
  status      DeliveryStatus @default(PLANIFIEE)
  scheduledAt DateTime
  deliveredAt DateTime?

  livreurId String?
  livreur   Livreur? @relation(fields: [livreurId], references: [id])

  /// Tournée du livreur dans laquelle cette livraison est prévue
  runId String?
  run   DeliveryRun? @relation(fields: [runId], references: [id])

  /// Frais payés par le client (dus même en cas de retour/annulation sur place, sauf exemption)
  deliveryFee Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([livreurId])
  @@index([scheduledAt])
  @@index([runId])
}

/// Point de départ des livraisons : la boutique aujourd'hui, d'autres points relais demain.
model PickupPoint {
  id        String   @id @default(cuid())
  name      String
  address   String?
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  orders    Order[]
  createdAt DateTime @default(now())
}

/// Grand quartier de référence : position (approximative, ajustable sur la carte admin)
/// et fourchette de frais de livraison annoncée à la cliente.
model Quartier {
  id       String  @id @default(cuid())
  name     String  @unique
  commune  String
  lat      Float
  lng      Float
  feeMin   Int?
  feeMax   Int?
  active   Boolean @default(true)
  position Int     @default(0)
  orders   Order[]
}

/// Réglages du calcul du coût des tournées (une seule ligne, id "default").
model DeliverySettings {
  id            String   @id @default("default")
  /// Prise en charge d'une tournée (le déplacement lui-même)
  baseFee       Int      @default(5000)
  /// Par kilomètre estimé
  perKm         Int      @default(1000)
  /// Par arrêt à partir du 2e (deux clientes voisines ne coûtent presque rien de plus)
  perExtraStop  Int      @default(1000)
  /// Compter le retour au point de départ
  includeReturn Boolean  @default(true)
  /// Distance à vol d'oiseau → distance par la route
  roadFactor    Float    @default(1.3)
  updatedAt     DateTime @default(now()) @updatedAt
}

/// Tournée : un livreur, une date, les livraisons emportées en un déplacement.
/// Le livreur est payé à la tournée (et non plus à la course).
model DeliveryRun {
  id            String      @id @default(cuid())
  livreurId     String
  livreur       Livreur     @relation(fields: [livreurId], references: [id])
  date          DateTime
  status        RunStatus   @default(PLANIFIEE)
  costMode      RunCostMode @default(CALCULE)
  /// Estimation au moment du dernier calcul
  estimatedKm   Float?
  suggestedCost Int         @default(0)
  /// Montant dû au livreur pour la tournée
  cost          Int         @default(0)
  /// Règlement fait : encaissements remis à la boutique, paie du livreur déduite
  settledAt     DateTime?
  notes         String?
  deliveries    Delivery[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt

  @@index([livreurId, date])
  @@index([settledAt])
}

/// Carte cadeau associée à une commande passée pour offrir à un tiers.
/// Créée uniquement si le client coche "Cette commande est un cadeau" au checkout.
/// Le message/la photo finaux sont validés par l'admin avant publication du lien public.
model GiftCard {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  recipientName    String
  recipientPhone   String
  recipientAddress String // adresse/quartier de livraison du destinataire — distincte de Order.quartier (celle de la cliente)
  message          String? // texte final de la carte ; si absent, généré à l'affichage
  photo            String? // nom de fichier Supabase Storage (bucket "catalogue") ; si absent, fallback hero-illustration.png

  printRequested Boolean @default(false) // impression physique de la carte demandée au checkout — ajoute GIFT_PRINT_FEE au total de la commande

  status      GiftCardStatus @default(DRAFT)
  token       String?        @unique // généré à la première publication
  publishedAt DateTime?
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
